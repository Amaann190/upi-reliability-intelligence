{
  "name": "UPI_Reliability",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Reliability",
        "columns": [
          {
            "name": "Bank",
            "dataType": "string",
            "sourceColumn": "UPI_Remitter_Banks",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "MMM yyyy"
          },
          {
            "name": "Volume",
            "dataType": "double",
            "sourceColumn": "Total_Volume_In_Million",
            "summarizeBy": "none"
          },
          {
            "name": "Approval fraction",
            "dataType": "double",
            "sourceColumn": "Approved_percent",
            "summarizeBy": "none"
          },
          {
            "name": "Technical decline fraction",
            "dataType": "double",
            "sourceColumn": "Technical_Decline_percent",
            "summarizeBy": "none"
          },
          {
            "name": "Reporting month",
            "sourceColumn": "Reporting month",
            "dataType": "string",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Volume (M)",
            "expression": "SUM(Reliability[Volume])",
            "formatString": "#,0.00"
          },
          {
            "name": "Technical declines (M)",
            "expression": "SUMX(Reliability, Reliability[Volume] * Reliability[Technical decline fraction])",
            "formatString": "#,0.00"
          },
          {
            "name": "Technical decline rate",
            "expression": "DIVIDE([Technical declines (M)], [Volume (M)])",
            "formatString": "0.00%"
          },
          {
            "name": "Approval rate",
            "expression": "DIVIDE(SUMX(Reliability, Reliability[Approval fraction] * Reliability[Volume]), [Volume (M)])",
            "formatString": "0.00%"
          },
          {
            "name": "Billion transactions",
            "expression": "DIVIDE([Volume (M)], 1000)",
            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "Reliability",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/remitter_banks_clean.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Clean = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Clean, {{\"Date\", type date},{\"Total_Volume_In_Million\", type number},{\"Approved_percent\", type number},{\"Technical_Decline_percent\", type number}}, \"en-US\"),",
                "    Eligible = Table.SelectRows(Typed, each [Total_Volume_In_Million] >= 1)",
                "in",
                "    Table.AddColumn(Eligible, \"Reporting month\", each Date.ToText([Date], \"yyyy-MM\"), type text)"
              ]
            }
          }
        ]
      },
      {
        "name": "Drivers",
        "columns": [
          {
            "name": "Month",
            "dataType": "dateTime",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "formatString": "MMM yyyy"
          },
          {
            "name": "Bank",
            "dataType": "string",
            "sourceColumn": "Bank",
            "summarizeBy": "none"
          },
          {
            "name": "Coverage",
            "dataType": "string",
            "sourceColumn": "Coverage",
            "summarizeBy": "none"
          },
          {
            "name": "Rate change pp",
            "dataType": "double",
            "sourceColumn": "Rate change pp",
            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "Volume change M",
            "dataType": "double",
            "sourceColumn": "Volume change M",
            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "Contribution pp",
            "dataType": "double",
            "sourceColumn": "Contribution pp",
            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "Rate effect pp",
            "dataType": "double",
            "sourceColumn": "Rate effect pp",
            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "Mix and coverage pp",
            "dataType": "double",
            "sourceColumn": "Mix and coverage pp",
            "summarizeBy": "none",
            "formatString": "0.0000"
          }
        ],
        "partitions": [
          {
            "name": "Drivers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/monthly_drivers.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Clean = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Clean, {{\"Month\", type date}, {\"Bank\", type text}, {\"Coverage\", type text}, {\"Rate change pp\", type number}, {\"Volume change M\", type number}, {\"Contribution pp\", type number}, {\"Rate effect pp\", type number}, {\"Mix and coverage pp\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:\\Users\\Amaan\\Desktop\\Fintech-Portfolio\\upi-reliability-intelligence\\data\\processed\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ]
  }
}